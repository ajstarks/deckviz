#!/bin/bash
./mkpage tools
./mkpage first
./mkpage vars
./mkpage coord
./mkpage colors
./mkpage text
./mkpage image
./mkpage graphics
./mkpage fgraphics
./mkpage list
./mkpage chart
./mkpage loop
./mkpage geo -layers="rect:image:poly:ellipse:text:line"
sans=PublicSans-Regular # IBMPlexSans-Regular # PublicSans-Regular # IBMPlexSans-Regular
mono=Inconsolata-Medium # FiraCode-Regular # Go-Mono # IntelOneMono-Regular # MartianMonoCondensed-Regular # OldTimeyMono # VictorMono-Thin # SF-Mono-Regular # Inconsolata-Medium # IBMPlexMono-Text
serif=Charter-Regular
decksh tut.dsh |
pdfdeck -sw \
 -layers="rect:image:poly:ellipse:text:line" \
 -stdout \
 -sans $sans \
 -mono $mono \
 -serif $serif - > tut.pdf
