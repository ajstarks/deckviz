deck
	eacolor="white"
	bgcolor="hsv(214,30,96)"
	txcolor="gray"
	rulecolor="black"
	loncolor="rgb(128,0,0)"
	latcolor="rgb(0,0,128)"
	slide bgcolor // "rgb(220,220,220)" //bgcolor txcolor
		
		// geographic bounds
		z=0
		north=90
		south=z-north
		east=180
		west=z-east
		lw=0.05
		rs=1.3
		plw=lw*7
	
		// canvas bounds
		geoXmin=5
		geoXmax=100-geoXmin
		geoYmin=10
		geoYmax=100-geoYmin
		geow=geoXmax-geoXmin
		geoh=geoYmax-geoYmin

		geoLatMin=south
		geoLatMax=north
		geoLonMin=west
		geoLonMax=east

		rect 50 50 geow geoh bgcolor

		rtext		"Latitude"  		48 		geoYmin 90	1.5 "sans" latcolor
		btext		"Longitude" 		geoXmin	53 			1.5 "sans" loncolor
		rtext		"Prime Meridian"	48		72		90 	1.2 "sans" latcolor
		ctext		"Equator"			55		48 			1.2 "sans" loncolor

		georegion	"world.kml"						 eacolor // south north west east eacolor
		geolabel	"lat.d" 						 rs "mono" 
		geopath		"geo:-90,0"		"geo:90,0"		 plw latcolor 20 // prime meridian
		// east
		geopath		"geo:-90,20"	"geo:90,20"		 lw rulecolor 50
		geopath		"geo:-90,40"	"geo:90,40"		 lw rulecolor 50
		geopath		"geo:-90,60"	"geo:90,60"		 lw rulecolor 50
		geopath		"geo:-90,80"	"geo:90,80"		 lw rulecolor 50
		geopath		"geo:-90,100"	"geo:90,100"	 lw rulecolor 50
		geopath		"geo:-90,120"	"geo:90,120"	 lw rulecolor 50
		geopath		"geo:-90,140"	"geo:90,140"	 lw rulecolor 50
		geopath		"geo:-90,160"	"geo:90,160"	 lw rulecolor 50
		geopath		"geo:-90,180"	"geo:90,180"	 lw rulecolor 50
		// west
		geopath		"geo:-90,-20"	"geo:90,-20"	 lw rulecolor 50
		geopath		"geo:-90,-40"	"geo:90,-40"	 lw rulecolor 50
		geopath		"geo:-90,-60"	"geo:90,-60"	 lw rulecolor 50
		geopath		"geo:-90,-80"	"geo:90,-80"	 lw rulecolor 50
		geopath		"geo:-90,-100"	"geo:90,-100"	 lw rulecolor 50
		geopath		"geo:-90,-120"	"geo:90,-120"	 lw rulecolor 50
		geopath		"geo:-90,-140"	"geo:90,-140"	 lw rulecolor 50
		geopath		"geo:-90,-160"	"geo:90,-160"	 lw rulecolor 50
		geopath		"geo:-90,-180"	"geo:90,-180"	 lw rulecolor 50
		
		geolabel	"lon.d" 						 rs"mono"
		geopath		"geo:0,-180"	"geo:0,180" 	 plw loncolor 20 // equator
		// north
		geopath		"geo:10,-180"	"geo:10,180"	 lw rulecolor 50
		geopath		"geo:20,-180"	"geo:20,180"	 lw rulecolor 50
		geopath		"geo:30,-180"	"geo:30,180"	 lw rulecolor 50
		geopath		"geo:40,-180"	"geo:40,180"	 lw rulecolor 50
		geopath		"geo:50,-180"	"geo:50,180"	 lw rulecolor 50
		geopath		"geo:60,-180"	"geo:60,180"	 lw rulecolor 50
		geopath		"geo:70,-180"	"geo:70,180"	 lw rulecolor 50
		geopath		"geo:80,-180"	"geo:80,180"	 lw rulecolor 50
		geopath		"geo:90,-180"	"geo:90,180"	 lw rulecolor 50
		// south
		geopath		"geo:-10,-180"	"geo:-10,180"	 lw rulecolor 50
		geopath		"geo:-20,-180"	"geo:-20,180"	 lw rulecolor 50
		geopath		"geo:-30,-180"	"geo:-30,180"	 lw rulecolor 50
		geopath		"geo:-40,-180"	"geo:-40,180"	 lw rulecolor 50
		geopath		"geo:-50,-180"	"geo:-50,180"	 lw rulecolor 50
		geopath		"geo:-60,-180"	"geo:-60,180"	 lw rulecolor 50
		geopath		"geo:-70,-180"	"geo:-70,180"	 lw rulecolor 50
		geopath		"geo:-80,-180"	"geo:-80,180"	 lw rulecolor 50
		geopath		"geo:-90,-180"	"geo:-90,180"	 lw rulecolor 50

	eslide

	slide "skyblue"
		geoLatMax=37.346983
        geoLatMin=0-34.833222
        geoLongMax=51.266667
        geoLongMin=0-17.520278

        geoXmin=40
        geoYmin=30
        geoXmax=70
        geoYmax=70

        p0=(geoXmin,geoYmin)
        p1=(geoXmin,geoXmax)
        p3=(geoXmax,geoXmax)
        p4=(geoXmax,geoYmin)

		georegion "africa.kml" "white"

		circle geoXmin geoYmin 0.5
		circle geoXmax geoYmax 0.5
		hline geoXmin geoYmin 

		gwidth=geoXmax-geoXmin
		gheight=geoYmax-geoYmin

		gw=gwidth/2
		gh=gheight/2
		gw=geoXmin+gw
		gh=geoYmin+gh
		rect gw gh gwidth gheight "steelblue" 15
		latmint=format "geoLatMin (%.3f)" geoLatMin
		latmaxt=format "geoLatMax (%.3f)" geoLatMax
		longmint=format "geoLongMin (%.3f)" geoLongMin
		longmaxt=format "geoLongMax (%.3f)" geoLongMax

		ctext latmint gw geoYmin 1.5 "mono"
		ctext latmaxt gw geoYmax 1.5 "mono"
		etext longmint geoXmin gh 1.5 "mono"
		btext longmaxt geoXmax gh 1.5 "mono"

		etext "(geoXmin, geoYmin)" geoXmin geoYmin 1.5 "mono"
		btext "(geoXmax, geoYmax)" geoXmax geoYmax 1.5 "mono"
	eslide

	slide
		ruler

        geoLatMax=37.346983
        geoLatMin=0-34.833222
        geoLongMax=51.266667
        geoLongMin=0-17.520278

        geoXmin=70
        geoYmax=20
        geoYmin=5
        geoXmax=80
        georegion "africa.kml" "gray"
        gwidth=geoXmax-geoXmin
		gheight=geoYmax-geoYmin

		gw=gwidth/2
		gh=gheight/2
		gw=geoXmin+gw
		gh=geoYmin+gh

		lab1=format "geoXmin=%v geoXmax=%v geoYmin=%v geoYmax=%v" geoXmin geoXmax geoYmin geoYmax
		lab2=format "geoLatMin=%.2f geoLatMax-%.2f geoLongMin=%.2f geoLongMax=%.2f" geoLatMin geoLatMax geoLongMin geoLongMax
		ctext lab1 75 25 1.2 "mono"
		ctext lab2 75 22 1.2 "mono"
		rect gw gh gwidth gheight "steelblue" 30


		geoXmin=0
		geoYmin=10
		geoXmax=100
		geoYmax=90
		geoLatMax=north
		geoLatMin=south
        geoLongMax=east
        geoLongMin=west

        georegion "world.kml" "black"
        georegion "africa.kml" "gray"
        rect 55 50.5 19 32 "steelblue" 30


	eslide



edeck
